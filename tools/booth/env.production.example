# Secrets/config for running the API natively on the photobooth cabin PC (Paso 3 of
# ESTADO_PROYECTO.md). Copy this file to `.env.production` (same folder) and fill in the real
# values — `.env.production` matches the `.env.*` pattern in .gitignore, so it's never committed.
# `start-booth.ps1` loads it into the process environment before launching the API + cloudflared.
#
# Where each value comes from:
#   ConnectionStrings__Postgres   Neon dashboard -> your project -> Connection Details. Neon gives
#                                  you a `postgresql://user:pass@host/db?sslmode=require` URI —
#                                  Npgsql doesn't parse that format, translate it to keyword=value:
#                                  Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<pass>;Ssl Mode=Require;Trust Server Certificate=true
#   Storage__AwsS3__*              Cloudflare dashboard -> R2 -> bucket "pix" -> Settings, and
#                                  "Manage R2 API Tokens" for the Access Key ID/Secret. BucketName
#                                  and ServiceUrl below are already filled in (not secret, visible
#                                  in the dashboard) — only the two keys are actually sensitive.
#                                  Region must be the literal string "auto" for R2 (not a real AWS
#                                  region — R2 ignores it, but the AWS SDK needs *something* set).
#   Storage__AwsS3__PublicUrlBase  The URL guests' browsers use to actually load a photo. Two
#                                  options — pick one in the R2 bucket's Settings -> Public Access:
#                                    - Quick start: enable "Public Development URL", use the
#                                      `https://pub-xxxxxxxx.r2.dev` URL it gives you.
#                                    - Nicer URLs: add a Custom Domain (e.g. fotos.somospix.com)
#                                      to the bucket, use that instead.
#                                  Either way: no bucket name in this URL, just the host.
#   CLOUDFLARE_TUNNEL_TOKEN        Zero Trust -> Networks -> Tunnels -> your tunnel -> the token
#                                  shown in the `cloudflared tunnel run --token ...` install command.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__Postgres=Host=REPLACE_ME.neon.tech;Port=5432;Database=REPLACE_ME;Username=REPLACE_ME;Password=REPLACE_ME;Ssl Mode=Require;Trust Server Certificate=true

Storage__Provider=AwsS3
Storage__PublicRead=true
Storage__AwsS3__BucketName=pix
Storage__AwsS3__Region=auto
Storage__AwsS3__AccessKeyId=REPLACE_ME
Storage__AwsS3__SecretAccessKey=REPLACE_ME
Storage__AwsS3__ServiceUrl=https://0c45f3c5ad49b738624be15c33e99444.r2.cloudflarestorage.com
Storage__AwsS3__PublicUrlBase=https://pub-a265008846d646b3b90185cf6a5efe9e.r2.dev

Cors__AllowedOrigins__0=https://somospix.com
Cors__AllowedOrigins__1=https://www.somospix.com

Watcher__Enabled=true
Watcher__RefreshIntervalSeconds=15

CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ME
