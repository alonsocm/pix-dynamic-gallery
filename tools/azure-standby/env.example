# Environment variables for the always-on "standby" instance of the API, deployed to Azure
# Container Apps. Same Docker image as src/PixDynamicGallery.Api/Dockerfile, no code changes — the
# only deliberate difference from the cabin PC's config (tools/booth/env.production.example) is
# Watcher__Enabled=false: this instance never touches a local filesystem, it only serves REST reads
# (and writes that don't need Sparkbooth — e.g. creating an event) against Neon/R2, so the gallery
# stays browsable even when the photobooth cabin is powered off. See ESTADO_PROYECTO.md for why.
#
# This file documents what to set as Container App environment variables in the Azure portal (or
# via `az containerapp create --env-vars ...`) — it isn't loaded by any script, unlike
# tools/booth/.env.production. Copy the real values from tools/booth/.env.production (Neon
# connection string, R2 credentials) — they're identical between the two instances, same database,
# same bucket.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__Postgres=<same value as tools/booth/.env.production>

Storage__Provider=AwsS3
Storage__PublicRead=true
Storage__AwsS3__BucketName=pix
Storage__AwsS3__Region=auto
Storage__AwsS3__AccessKeyId=<same value as tools/booth/.env.production>
Storage__AwsS3__SecretAccessKey=<same value as tools/booth/.env.production>
Storage__AwsS3__ServiceUrl=https://0c45f3c5ad49b738624be15c33e99444.r2.cloudflarestorage.com
Storage__AwsS3__PublicUrlBase=https://pub-a265008846d646b3b90185cf6a5efe9e.r2.dev

Cors__AllowedOrigins__0=https://somospix.com
Cors__AllowedOrigins__1=https://www.somospix.com

# The one deliberate difference from the cabin's config — this instance has no Sparkbooth folder to
# watch, and must never try.
Watcher__Enabled=false
